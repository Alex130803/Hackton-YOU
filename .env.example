# Demo mode: whole app works end to end with mock data and no keys.
USE_MOCKS=true

# You.com — https://you.com/docs  (header X-API-Key)
YDC_API_KEY=

# LLM for drafting (provider TBD)
LLM_API_KEY=

# SMS: twilio | infobip
SMS_PROVIDER=twilio
# whatsapp (default) or sms. WhatsApp uses Twilio's sandbox (+14155238886) unless TWILIO_WHATSAPP_FROM is set;
# the receiving phone must first send "join <code>" to the sandbox from WhatsApp.
MESSAGE_CHANNEL=whatsapp
TWILIO_WHATSAPP_FROM=
# Test mode: while set, EVERY SMS goes only to this number (e.g. your own phone), never to brands
SMS_TEST_NUMBER=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

INFOBIP_BASE_URL=
INFOBIP_API_KEY=
INFOBIP_FROM=
